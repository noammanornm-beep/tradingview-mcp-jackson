// ═══════════════════════════════════════════════════════════════
// Small Cap Pivot Map — Multi-Timeframe Strength
// Finds pivot H/L on Weekly, Daily, Hourly — clusters levels —
// draws stronger/thicker lines for higher-timeframe clusters.
// ═══════════════════════════════════════════════════════════════
//@version=5
indicator("SC Pivot Levels", shorttitle="SC Pivots", overlay=true, max_lines_count=500, max_labels_count=200)

// ── Inputs ────────────────────────────────────────────────────
leftBars   = input.int(3,   "Pivot Left Bars",   minval=1, maxval=10)
rightBars  = input.int(3,   "Pivot Right Bars",  minval=1, maxval=10)
zonePct    = input.float(2.5,"Cluster Zone %",   minval=0.5, maxval=5.0, step=0.5)
minTouches = input.int(2,   "Min Touches to Draw", minval=1, maxval=10)
showW      = input.bool(true, "Weekly Levels")
showD      = input.bool(true, "Daily Levels")
showH      = input.bool(true, "Hourly Levels")
extendR    = input.bool(true, "Extend Lines Right")
showLbl    = input.bool(true, "Show Labels")

// ── Volume coloring ───────────────────────────────────────────
avgVol  = ta.sma(volume, 20)
rvol    = volume / avgVol
volCol  = rvol >= 20 ? color.new(#f0883e, 0)  :
          rvol >= 10 ? color.new(#f85149, 10) :
          rvol >= 5  ? color.new(#da3633, 30) :
          rvol >= 3  ? color.new(#d29922, 20) :
                       color.new(#3d444d, 50)
barcolor(volCol)

// FIX 3: Only show volume labels on the last (live) bar, not all historical bars
if barstate.islast
    if rvol >= 20
        label.new(bar_index, high, "🔥 " + str.tostring(math.round(rvol,1)) + "×\nSPECIAL",
          style=label.style_label_down, color=color.new(#f0883e,10),
          textcolor=color.white, size=size.small, yloc=yloc.abovebar)
    else if rvol >= 10
        label.new(bar_index, high, str.tostring(math.round(rvol,1)) + "×",
          style=label.style_label_down, color=color.new(#f85149,20),
          textcolor=color.white, size=size.tiny, yloc=yloc.abovebar)

// ── Fetch pivot H/L from each timeframe ──────────────────────
wH = request.security(syminfo.tickerid, "W",  ta.pivothigh(high, leftBars, rightBars), lookahead=barmerge.lookahead_off)
wL = request.security(syminfo.tickerid, "W",  ta.pivotlow(low,   leftBars, rightBars), lookahead=barmerge.lookahead_off)
dH = request.security(syminfo.tickerid, "D",  ta.pivothigh(high, leftBars, rightBars), lookahead=barmerge.lookahead_off)
dL = request.security(syminfo.tickerid, "D",  ta.pivotlow(low,   leftBars, rightBars), lookahead=barmerge.lookahead_off)
hH = request.security(syminfo.tickerid, "60", ta.pivothigh(high, leftBars, rightBars), lookahead=barmerge.lookahead_off)
hL = request.security(syminfo.tickerid, "60", ta.pivotlow(low,   leftBars, rightBars), lookahead=barmerge.lookahead_off)

// ── Level storage (price, touch count, max TF weight) ────────
// TF weight: Weekly=3, Daily=2, Hourly=1
var float[] px  = array.new_float()
var int[]   cnt = array.new_int()
var int[]   wgt = array.new_int()

findZone(p) =>
    res = -1
    for i = 0 to array.size(px) - 1
        if math.abs(p - array.get(px, i)) / array.get(px, i) * 100 <= zonePct
            res := i
            break
    res

addPivot(p, tfWgt) =>
    if not na(p) and p > 0
        idx = findZone(p)
        if idx >= 0
            old = array.get(px, idx)
            n   = array.get(cnt, idx)
            array.set(px,  idx, (old * n + p) / (n + 1))
            array.set(cnt, idx, n + 1)
            if tfWgt > array.get(wgt, idx)
                array.set(wgt, idx, tfWgt)
        else
            array.push(px,  p)
            array.push(cnt, 1)
            array.push(wgt, tfWgt)

// FIX 2: Only accumulate pivots on the last bar — avoids O(n²) blowup across all bars
if barstate.islast
    if showW
        addPivot(wH, 3)
        addPivot(wL, 3)
    if showD
        addPivot(dH, 2)
        addPivot(dL, 2)
    if showH
        addPivot(hH, 1)
        addPivot(hL, 1)

// ── Draw on last bar only ────────────────────────────────────
var line[]  drawnLines  = array.new_line()
var label[] drawnLabels = array.new_label()

if barstate.islast
    // FIX 1: Guard against empty arrays before looping
    if array.size(drawnLines) > 0
        for i = 0 to array.size(drawnLines) - 1
            line.delete(array.get(drawnLines, i))
    if array.size(drawnLabels) > 0
        for i = 0 to array.size(drawnLabels) - 1
            label.delete(array.get(drawnLabels, i))
    array.clear(drawnLines)
    array.clear(drawnLabels)

    ext = extendR ? extend.right : extend.none
    n   = array.size(px)

    if n > 0
        for i = 0 to n - 1
            p  = array.get(px,  i)
            c  = array.get(cnt, i)
            w  = array.get(wgt, i)

            if c < minTouches
                continue

            // Color & width: higher TF + more touches = redder & thicker
            col   = color.new(#8b949e, 70)
            lw    = 1
            lsty  = line.style_dashed

            if w >= 3 and c >= 3        // Weekly, 3+ touches — strongest
                col  := color.new(#ff0000, 0)
                lw   := 3
                lsty := line.style_solid
            else if w >= 3 and c >= 2   // Weekly, 2 touches
                col  := color.new(#f85149, 10)
                lw   := 2
                lsty := line.style_solid
            else if w >= 3              // Weekly, 1 touch
                col  := color.new(#da3633, 30)
                lw   := 1
                lsty := line.style_solid
            else if w == 2 and c >= 3   // Daily, 3+ touches
                col  := color.new(#f0883e, 0)
                lw   := 2
                lsty := line.style_solid
            else if w == 2 and c >= 2   // Daily, 2 touches
                col  := color.new(#d29922, 10)
                lw   := 1
                lsty := line.style_solid
            else if w == 2              // Daily, 1 touch
                col  := color.new(#d29922, 50)
                lw   := 1
                lsty := line.style_dashed
            else                        // Hourly only
                col  := color.new(#8b949e, 60)
                lw   := 1
                lsty := line.style_dashed

            ln = line.new(bar_index - 300, p, bar_index, p,
              color=col, width=lw, style=lsty, extend=ext)
            array.push(drawnLines, ln)

            if showLbl
                tfStr  = w >= 3 ? "W" : w == 2 ? "D" : "H"
                role   = p > close ? "R" : "S"
                stars  = c >= 3 ? "★★★" : c == 2 ? "★★" : "★"
                pctOff = str.tostring(math.round((p - close) / close * 100, 1)) + "%"
                txt    = role + " " + stars + " [" + tfStr + "] $" + str.tostring(math.round(p, 3)) + "  " + pctOff
                lbl = label.new(bar_index, p, txt,
                  style=label.style_label_left,
                  color=color.new(color.black, 85),
                  textcolor=col,
                  size=c >= 3 ? size.small : size.tiny)
                array.push(drawnLabels, lbl)
